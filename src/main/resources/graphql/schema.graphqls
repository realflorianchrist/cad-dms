scalar DateTime
scalar Long

type User {
  userId: ID!
  displayName: String!
}

type Project {
  projectId: ID!
  name: String!

  createdAt: DateTime!
  createdBy: User!

  updatedAt: DateTime!
  updatedBy: User!

  archived: Boolean!

  documents: [Document!]!
  directories: [Directory!]!
}

type Directory {
  directoryId: ID!
  name: String!

  createdAt: DateTime!
  createdBy: User!

  updatedAt: DateTime!
  updatedBy: User!

  archived: Boolean!

  documents: [Document!]!
  directories: [Directory!]!
}

type Document {
  documentId: ID!

  createdAt: DateTime!
  createdBy: User!

  updatedAt: DateTime!
  updatedBy: User!

  archived: Boolean!

  currentVersion: DocumentVersion!
  versions: [DocumentVersion!]!
}

type DocumentVersion {
  documentVersionId: ID!
  number: Int!
  name: String!
  extension: String!
  contentHash: String!
  storageKey: String!
  fileSize: Long!
  createdAt: DateTime!
  createdBy: User!
}

# type Data {
#   documents: [Document!]!
#   directories: [Directory!]!
# }

type Query {
  user(userId: ID!): User
  users: [User!]!

  project(projectId: ID!): Project
  projects: [Project!]!

  directory(directoryId: ID!): Directory

  # projectData(projectId: ID!): Data!
  # directoryData(directoryId: ID!): Data!

  # directoryTree(directoryId: ID!, depth: Int! = 2): Directory!
}
