scalar DateTime
scalar Long

enum MetadataType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  ENUM
}

enum MetadataTargetType {
  DIRECTORY
  DOCUMENT
}

enum MetadataReach {
  SELF
  CHILDREN
  DESCENDANTS
}

type MetadataDefinition {
  metadataDefinitionId: ID!
  key: String!
  label: String!
  type: MetadataType!
  options: [String!]!
}

type MetadataBinding {
  definition: MetadataDefinition!
  targetTypes: [MetadataTargetType!]!
  reach: MetadataReach!
  required: Boolean!
  defaultValue: String
}

type MetadataValue {
  definition: MetadataDefinition!
  value: String!
}

type User {
  userId: ID!
  displayName: String!
}

type Directory {
  directoryId: ID!
  name: String!

  createdAt: DateTime!
  createdBy: User!

  updatedAt: DateTime!
  updatedBy: User!

  archived: Boolean!

  documents: [Document!]!
  directories: [Directory!]!

  metadataBindings: [MetadataBinding!]!
  metadataValues: [MetadataValue!]!
}

type Document {
  documentId: ID!

  createdAt: DateTime!
  createdBy: User!

  updatedAt: DateTime!
  updatedBy: User!

  archived: Boolean!

  currentVersion: DocumentVersion!
  versions: [DocumentVersion!]!

  metadataBindings: [MetadataBinding!]!
  metadataValues: [MetadataValue!]!
}

type DocumentVersion {
  documentVersionId: ID!
  number: Int!
  name: String!
  extension: String!
  contentHash: String!
  storageKey: String!
  fileSize: Long!
  createdAt: DateTime!
  createdBy: User!
}

type Query {
  user(userId: ID!): User
  users: [User!]!

  directory(directoryId: ID!): Directory
  directories: [Directory!]!
  rootDirectories: [Directory!]!
}
